# StoreHub API (HTTP Basic auth: username = back-office subdomain, password = API token)
STOREHUB_USERNAME=
STOREHUB_TOKEN=
STOREHUB_BASE_URL=https://api.storehubhq.com
# Never exceed 2 calls per second (StoreHub blocks above 3)
STOREHUB_RPS=2

# Web app
HOST=127.0.0.1
PORT=8000
# How people on the shop network reach this server; alerts in Lark link back to it
BASE_URL=
SECRET_KEY=change-me
DATA_DIR=C:/RetailOS/data

# Optional Lark mirror (leave empty to disable)
LARK_APP_ID=
LARK_APP_SECRET=
LARK_BASE_TOKEN=
